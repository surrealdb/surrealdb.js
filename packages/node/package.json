    "license": "Apache-2.0",
    "scripts": {
        "build": "bun run build.ts",
        "deploy": "bun run ../../scripts/publish.ts"
    },
    "type": "module",
    "dependencies": {
        "@surrealdb/node-native": "link:@surrealdb/node-native"
    }
