{
    "name": "@surrealdb/node",
    "version": "3.0.4",
    "repository": {
        "type": "git",
        "url": "https://github.com/surrealdb/surrealdb.js.git"
    },
    "devDependencies": {
        "surrealdb": "^2.0.1",
        "dts-bundle-generator": "^9.5.1",
        "rolldown": "1.0.0-beta.31"
    },
    "peerDependencies": {
        "surrealdb": "^2.0.1"
